# Gemini — content turns + vision verification + the demo surface's laptop TTS.
GEMINI_API_KEY=

# Content-turn determinism for filming (design doc §5.2).
LLM_TEMPERATURE=0.2

# Spending safety nets. Past either limit Gemini is turned off for the rest of
# the run (restart to continue). Closing the last demo page pauses Gemini after
# PAUSE_WHEN_PAGES_CLOSED_SEC; no clicks or typing for AUTO_PAUSE_IDLE_MIN
# pauses it too.
GEMINI_MAX_CALLS_PER_MINUTE=40
GEMINI_MAX_CALLS_PER_RUN=800
PAUSE_WHEN_PAGES_CLOSED_SEC=10
AUTO_PAUSE_IDLE_MIN=15

# Models. VISION_MODEL was picked by benchmark (docs/CHECKING.md §5) — a newer
# model isn't automatically better for a voice guide. Keep a PINNED id for
# filming; aliases like gemini-flash-latest can change mid-shoot.
VISION_MODEL=gemini-3.5-flash
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore

# Glasses (README §2). The phone app in phone/ connects to PORT and must
# present this shared secret — make one with `openssl rand -hex 24` and put the
# same value in phone/.env as EXPO_PUBLIC_BRIDGE_TOKEN.
BRIDGE_TOKEN=

# Glasses stream + app server.
RTMP_HOST=
PORT=3000
RTMP_PORT=1935

# Toolkit file store for THIS app. Never point it at the onboarding
# service's DATA_DIR — stores are single-writer (docs/PLAN.md §3.7).
APP_DATA_DIR=./data

# Which mode the app boots in: baseline | toolkit. Panels toggle it live.
# Baseline is the film's first take; toolkit reads the profile at boot.
GUIDE_MODE=baseline

# FILM_MODE=on locks voice_id constant and disables the voicePitch voice swap,
# so both A/B takes use the same voice (design doc §2's same-voice rule).
FILM_MODE=on

# The one film voice (ElevenLabs voice id). Empty = Mentra's server default.
ELEVEN_VOICE_ID=

# Past runs. Every Start→Stop take is saved under RUNS_DIR (what was said, the
# camera frame behind each turn, the spoken clips); the newest RUNS_KEEP are
# kept.
RUNS_DIR=./runs
RUNS_KEEP=40

# The lock on the app's public pages: the control panel at /webview (it shows
# the glasses' live camera picture and its buttons drive the guide), the past
# runs at /webview/runs (images from inside someone's home) and /debug/frame.
# A browser is asked for it (any user name); until it is set those pages
# answer 404. The phone app gets in with BRIDGE_TOKEN instead. Make one with
# `openssl rand -hex 16`.
ADMIN_PASSWORD=

# Deploying (scripts/deploy.sh, `bun run deploy`): the GCP VM the server runs
# on and the URL nginx answers on. Only this laptop's .env needs these.
DEPLOY_VM=
DEPLOY_ZONE=
PUBLIC_URL=
