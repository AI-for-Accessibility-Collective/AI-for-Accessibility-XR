{
  "name": "wearable-extension",
  "version": "0.1.0",
  "description": "AI for Accessibility XR: an audio-first smart-glasses guide shaped by the AI for Accessibility Toolkit (linked as a sibling checkout). One app, one model, two toolkit touch points: the prompt (input) and the spoken delivery (output).",
  "type": "module",
  "scripts": {
    "demo": "bun src/scripts/drive-core.ts",
    "stop": "bun scripts/stop.ts",
    "start": "bun src/index.ts",
    "deploy": "bash scripts/deploy.sh",
    "dev": "bun --hot src/index.ts",
    "import:profile": "bun scripts/import-profile.mjs",
    "test": "bun test",
    "check": "bun scripts/check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai4a11y/toolkit": "file:../AI-for-Accessibility-Toolkit/toolkit",
    "express": "^4.21.2",
    "node-media-server": "^2.7.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.14",
    "@types/ws": "^8.5.13",
    "bun-types": "^1.3.10",
    "typescript": "^5.0.0"
  }
}
